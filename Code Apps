// Perbaikan:
// 1. ID baru dihitung dari MAX(id) + 1, bukan rows.length (anti-bentrok)
// 2. Header sheet dinormalisasi (trim + lowercase) di semua fungsi
//    supaya tidak masalah mau kolom ditulis "NIS", "Nis", atau "nis"
// 3. CORS TIDAK pakai setHeader() (method itu tidak ada di
//    ContentService.TextOutput dan akan error). CORS aman selama:
//    - Deploy: Web app, Execute as Me, Who has access: Anyone
//    - Frontend fetch pakai Content-Type: text/plain;charset=utf-8
// ============================================================

// ---------- HELPER ----------

// Normalisasi nama kolom: trim spasi + lowercase
function normalizeKey_(key) {
  return String(key).trim().toLowerCase();
}

// Ambil array header yang sudah dinormalisasi dari baris pertama sheet
function getNormalizedHeaders_(rows) {
  return rows[0].map(function(h) {
    return normalizeKey_(h || "");
  });
}

// Cari ID baru yang aman (MAX id yang ada + 1), anti tabrakan
// walau sudah ada data yang dihapus sebelumnya
function getNextId_(rows) {

  var maxId = 0;

  for (var i = 1; i < rows.length; i++) {

    var idVal = parseInt(rows[i][0],10);

    if (!isNaN(idVal) && idVal > maxId) {
      maxId = idVal;
    }

  }

  return maxId + 1;

}
function getSheetIgnoreCase_(name) {

  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheets = ss.getSheets();

  for (var i = 0; i < sheets.length; i++) {

    if (
      sheets[i].getName().toLowerCase() ==
      String(name).toLowerCase()
    ) {
      return sheets[i];
    }

  }

  return null;

}
// ---------- ENTRY POINT ----------

function doGet(e) {
  var output = ContentService.createTextOutput(JSON.stringify({ status: "API SIM AKTIF", message: "Gunakan POST request." }));
  output.setMimeType(ContentService.MimeType.JSON);
  return output;
}

function doPost(e) {
  try {
    var request = JSON.parse(e.postData.contents);
    var action = request.action;
    var response = { success: false, message: "Action tidak dikenali." };

    if (action === 'login') {
      response = login_(request);
    } else if (action === 'getTableData') {
      response = getTableData_(request);
    } else if (action === 'saveRecord') {
      response = saveRecord_(request);
    } else if (action === 'deleteRecord') {
      response = deleteRecord_(request);
    } else if (action === 'getDashboardStats') {
      response = getDashboardStats_(request);
    }

    var output = ContentService.createTextOutput(JSON.stringify(response));
    output.setMimeType(ContentService.MimeType.JSON);
    return output;

  } catch (err) {
    var output = ContentService.createTextOutput(JSON.stringify({ success: false, message: "Error: " + err.toString() }));
    output.setMimeType(ContentService.MimeType.JSON);
    return output;
  }
}

// ---------- LOGIN ----------

function login_(data) {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("pengguna");
  if (!sheet) return { success: false, message: "Sheet pengguna tidak ditemukan" };

  var rows = sheet.getDataRange().getValues();
  var headers = getNormalizedHeaders_(rows);
  var idxUser = headers.indexOf("username");
  var idxPass = headers.indexOf("password");
  var idxNama = headers.indexOf("nama");
  var idxRole = headers.indexOf("role");

  for (var i = 1; i < rows.length; i++) {
    var row = rows[i];
    if (
        String(row[idxUser]).trim().toLowerCase() ==
        String(data.username).trim().toLowerCase() &&
        String(row[idxPass]).trim() ==
        String(data.password).trim()
        )
      return {
        success: true,
        user: {
          username: String(row[idxUser]).trim(),
          nama: String(row[idxNama]).trim(),
          role: String(row[idxRole]).trim()
        }
      };
    }
    return { success: false, message: "Username atau password salah" };
  }

// ---------- GENERIC CRUD ----------

function getTableData_(data) {
  var sheet = getSheetIgnoreCase_(data.sheetName);
  function getSheetIgnoreCase_(name){
  
  if (!sheet) return { success: false, message: "Sheet " + data.sheetName + " tidak ditemukan" };

  var rows = sheet.getDataRange().getValues();
  if (rows.length < 2) return { success: true, data: [] };

  var headers = getNormalizedHeaders_(rows);
  var tz = Session.getScriptTimeZone();
  var result = [];
  for (var i = 1; i < rows.length; i++) {
    if (!rows[i][0]) continue;
    var obj = {};
    for (var j = 0; j < headers.length; j++) {
      var cellVal = rows[i][j];
      // Kolom tanggal di Sheets tersimpan sebagai object Date -> format
      // jadi "yyyy-MM-dd" polos (tanpa jam) supaya cocok dengan <input type="date">
      if (cellVal instanceof Date) {
        cellVal = Utilities.formatDate(cellVal, tz, "yyyy-MM-dd");
      }
      obj[headers[j]] = cellVal;
    }
    result.push(obj);
  }
  return { success: true, data: result };
}

function saveRecord_(data) {
  var sheet = getSheetIgnoreCase_(data.sheetName);
  function getSheetIgnoreCase_(name){
  
  if (!sheet) return { success: false, message: "Sheet tidak ditemukan" };

  var rows = sheet.getDataRange().getValues();
  var headers = getNormalizedHeaders_(rows);
  var record = data.data;
  var id = record.id;

  if (id) {
    // ----- UPDATE (batch write, 1x request per baris, bukan per kolom) -----
    for (var i = 1; i < rows.length; i++) {
      if (String(rows[i][0]) === String(id)) {
        var updatedRow = rows[i].slice(); // copy baris lama sebagai basis
        for (var j = 0; j < headers.length; j++) {
          var key = headers[j];
          if (key === 'id') continue; // kolom ID tidak boleh ditimpa
          if (record.hasOwnProperty(key)) {
          updatedRow[j] = record[key];
          }
        }
        sheet.getRange(i + 1, 1, 1, headers.length).setValues([updatedRow]);
        return { success: true, message: "Data berhasil diupdate" };
      }
    }
    return { success: false, message: "ID tidak ditemukan" };
  } else {
    // ----- INSERT -----
    var newId = getNextId_(rows);
        var newRow = [newId];
    for (var k = 1; k < headers.length; k++) {
      newRow.push(record[headers[k]] || '');
    }
    sheet.getRange(sheet.getLastRow()+1,1,1,newRow.length).setValues([newRow]);
    return { success: true, message: "Data berhasil ditambahkan", id: newId };
  }
}

