// ---------- DASHBOARD ----------

function getDashboardStats_(data) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheetSantri = ss.getSheetByName("Santri");
  var sheetPelanggaran = ss.getSheetByName("Pelanggaran");
  var sheetPerizinan = ss.getSheetByName("Perizinan");

  if (!sheetSantri || !sheetPelanggaran || !sheetPerizinan) 
    {return { success: false, message: "Sheet tidak ditemukan (Santri, Pelanggaran, Perizinan)." };
  }

  var dataSantri = sheetSantri.getDataRange().getValues();
  var headersSantri = getNormalizedHeaders_(dataSantri);
  var idxStatus = headersSantri.indexOf("status");
  if (idxStatus === -1) {
    return {
        success:false,
        message:"Kolom STATUS tidak ditemukan pada sheet Santri."
    };
}
  var idxKamar = headersSantri.indexOf("kamar");
  var idxKelas = headersSantri.indexOf("kelas");
  var idxAsrama = headersSantri.indexOf("asrama");
  var idxNamaSantri = headersSantri.indexOf("nama");

  var totAktif = 0, totNonaktif = 0, totLulus = 0, totPindah = 0, totKeluar = 0;
  var kamarCount = {}, kelasCount = {}, gedungCount = {};

  for (var i = 1; i < dataSantri.length; i++) {
    var row = dataSantri[i];
    if (!row[idxStatus]) continue;
    var status = row[idxStatus].toString().trim().toLowerCase();
    var kamar = row[idxKamar] ? row[idxKamar].toString().trim() : "";
    var kelas = row[idxKelas] ? row[idxKelas].toString().trim() : "";
    var gedung = row[idxAsrama] ? row[idxAsrama].toString().trim() : "";

    if (status === "aktif") totAktif++;
    else if (status === "nonaktif") totNonaktif++;
    else if (status === "lulus") totLulus++;
    else if (status === "pindah") totPindah++;
    else if (status === "keluar") totKeluar++;

    if (status === "aktif") {
      if (kamar) kamarCount[kamar] = (kamarCount[kamar] || 0) + 1;
      if (kelas) kelasCount[kelas] = (kelasCount[kelas] || 0) + 1;
      if (gedung) gedungCount[gedung] = (gedungCount[gedung] || 0) + 1;
    }
  }

  var dataPel = sheetPelanggaran.getDataRange().getValues();
  var headersPel = getNormalizedHeaders_(dataPel);
  var idxTanggal = headersPel.indexOf("tanggal");
  var idxNama = headersPel.indexOf("nama_santri");
  var idxPelanggaran = headersPel.indexOf("pelanggaran");
  var idxKeterangan = headersPel.indexOf("keterangan");

if (idxKeterangan == -1) {
    idxKeterangan = headersPel.indexOf("poin");
}

  var now = new Date();
  var currMonth = now.getMonth() + 1;
  var currYear = now.getFullYear();
  var totPelanggaranBulanIni = 0;
  var monthlyCount = {};
  var pelanggaranTerbaru = [];
  // Hitung jumlah kasus per kategori Keterangan, khusus bulan berjalan
  var keteranganCount = {
    "Surat Hijau": 0, "Surat Kuning": 0, "Surat Merah": 0,
    "SP-1": 0, "SP-2": 0, "SP-2.1": 0, "SP-2.2": 0, "SP-3 (DO)": 0
  };

  for (var j = 1; j < dataPel.length; j++) {
    var rowPel = dataPel[j];
    var tgl = new Date(rowPel[idxTanggal]);
    if (isNaN(tgl.getTime())) continue;

    var nama = rowPel[idxNama] ? rowPel[idxNama].toString().trim() : "";
    var keterangan = rowPel[idxKeterangan] ? rowPel[idxKeterangan].toString().trim() : "";
    var key = tgl.getFullYear() + "-" + ("0" + (tgl.getMonth() + 1)).slice(-2);

    if (tgl.getMonth() + 1 === currMonth && tgl.getFullYear() === currYear) {
      totPelanggaranBulanIni++;
      if (keteranganCount.hasOwnProperty(keterangan)) keteranganCount[keterangan]++;
    }

    monthlyCount[key] = (monthlyCount[key] || 0) + 1;

    pelanggaranTerbaru.push({
      nama_santri: nama,
      pelanggaran: rowPel[idxPelanggaran] ? rowPel[idxPelanggaran].toString() : "",
      keterangan: keterangan,
      tanggal: Utilities.formatDate(tgl, Session.getScriptTimeZone(), "yyyy-MM-dd")
    });
  }

  pelanggaranTerbaru.sort(function(a, b) { return new Date(b.tanggal) - new Date(a.tanggal); });
  pelanggaranTerbaru = pelanggaranTerbaru.slice(0, 5);

  var months = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
  var chartLabels = [], chartData = [];
  for (var m = 5; m >= 0; m--) {
    var d = new Date(currYear, currMonth - 1 - m, 1);
    var label = months[d.getMonth()];
    var key = d.getFullYear() + "-" + ("0" + (d.getMonth() + 1)).slice(-2);
    chartLabels.push(label);
    chartData.push(monthlyCount[key] || 0);
  }

  var dataIzin = sheetPerizinan.getDataRange().getValues();
  var headersIzin = getNormalizedHeaders_(dataIzin);
  var idxJenis = headersIzin.indexOf("jenis");
  var idxStatusIzin = headersIzin.indexOf("status");
  var idxNamaIzin = headersIzin.indexOf("nama_santri");
  var idxTglIzin = headersIzin.indexOf("tanggal");
  var idxKet = headersIzin.indexOf("keterangan");

  var totIzin = 0, totSakit = 0;
  var izinSakitTerbaru = [];
  for (var p = 1; p < dataIzin.length; p++) {
    var rowIzin = dataIzin[p];
    var jenis = rowIzin[idxJenis] ? rowIzin[idxJenis].toString().trim().toLowerCase() : "";
    var statusIzin = rowIzin[idxStatusIzin] ? rowIzin[idxStatusIzin].toString().trim().toLowerCase() : "";
    if (statusIzin !== "disetujui") continue;

    if (jenis === "izin") totIzin++;
    else if (jenis === "sakit") totSakit++;

    izinSakitTerbaru.push({
      nama_santri: rowIzin[idxNamaIzin] || "",
      jenis: jenis,
      keterangan: rowIzin[idxKet] || "-",
      tanggal: rowIzin[idxTglIzin] ? Utilities.formatDate(new Date(rowIzin[idxTglIzin]), Session.getScriptTimeZone(), "yyyy-MM-dd") : "-"
    });
  }
  izinSakitTerbaru.sort(function(a, b) { return new Date(b.tanggal) - new Date(a.tanggal); });
  izinSakitTerbaru = izinSakitTerbaru.slice(0, 5);

  return {
    success: true,
    data: {
      totAktif: totAktif,
      totNonaktif: totNonaktif,
      totLulus: totLulus,
      totPindah: totPindah,
      totKeluar: totKeluar,
      totIzin: totIzin,
      totSakit: totSakit,
      totPelanggaran: totPelanggaranBulanIni,
      chartPelLabels: chartLabels,
      chartPelData: chartData,
      keteranganCount: keteranganCount,
      santriPerKamar: Object.keys(kamarCount).map(function(k) { return {kamar: k, jumlah: kamarCount[k]}; }),
      santriPerKelas: Object.keys(kelasCount).map(function(k) { return {kelas: k, jumlah: kelasCount[k]}; }),
      santriPerGedung: Object.keys(gedungCount).map(function(g) { return {gedung: g, jumlah: gedungCount[g]}; }),
      pelanggaranTerbaru: pelanggaranTerbaru,
      izinSakitTerbaru: izinSakitTerbaru
    }
  };
}
